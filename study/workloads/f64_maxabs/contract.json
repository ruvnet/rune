{
  "name": "rune-study/f64_maxabs",
  "kernel_dir": ".",
  "test_cmd": [
    "cargo",
    "test",
    "--release",
    "--offline",
    "--quiet",
    "--test",
    "visible"
  ],
  "holdout_dir": "holdout",
  "holdout_dest": "tests",
  "holdout_cmd": [
    "cargo",
    "test",
    "--release",
    "--offline",
    "--quiet",
    "--test",
    "holdout"
  ],
  "bench_cmd": [
    "cargo",
    "run",
    "--release",
    "--offline",
    "--quiet",
    "--bin",
    "bench",
    "--",
    "1024"
  ],
  "guard_benches": [
    {
      "name": "len7",
      "bench_cmd": [
        "cargo",
        "run",
        "--release",
        "--offline",
        "--quiet",
        "--bin",
        "bench",
        "--",
        "7"
      ],
      "tolerance": 0.1
    },
    {
      "name": "len1000003",
      "bench_cmd": [
        "cargo",
        "run",
        "--release",
        "--offline",
        "--quiet",
        "--bin",
        "bench",
        "--",
        "1000003"
      ],
      "tolerance": 0.1
    }
  ],
  "samples": 40,
  "warmup": 5,
  "min_improvement": 0.1,
  "forbid_unsafe": true,
  "forbid_new_deps": true,
  "forbid_new_capabilities": true,
  "max_seconds": 300,
  "max_memory_mb": 8192
}
